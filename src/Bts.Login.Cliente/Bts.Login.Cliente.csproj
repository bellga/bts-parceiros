<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Bts.Login.Cliente</PackageId>
    <Description>"Entrar com BTS" para apps (.NET, MAUI, desktop): Authorization Code + PKCE pelo navegador do sistema, validação do id_token, renovação e saída. Inclui o retorno local (127.0.0.1) para apps de computador.</Description>
    <PackageTags>bts;bellga;login;openid-connect;oidc;pkce;maui</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Bts.Login.Cliente.Testes" />
  </ItemGroup>
</Project>
